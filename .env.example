# Upstash Redis — REST API credentials
# Get these from https://console.upstash.com -> create a Redis database -> REST API tab
UPSTASH_REDIS_REST_URL=https://your-region-your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Cloudflare R2 — S3-compatible object storage credentials
# Get Account ID from https://dash.cloudflare.com -> R2 Overview (right sidebar)
R2_ACCOUNT_ID=your-cloudflare-account-id
# Create an R2 API token at https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# The name of your R2 bucket (create one at https://dash.cloudflare.com -> R2 -> Create bucket)
R2_BUCKET_NAME=your-r2-bucket-name

# Optional: use any S3-compatible backend instead of Cloudflare R2 (e.g. self-hosted
# MinIO or Garage). Leave these unset to use R2 with the defaults above.
# S3_ENDPOINT: full URL of the S3 API endpoint (overrides the R2 endpoint).
# S3_FORCE_PATH_STYLE: set to "true" for backends served from a single hostname (MinIO/Garage).
# S3_REGION: region to sign requests with (defaults to "auto", which R2 expects).
# When S3_ENDPOINT is set, R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY hold that backend's
# credentials and R2_ACCOUNT_ID is ignored.
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=true
# S3_REGION=auto

# Secret used to authorize internal cleanup calls (e.g., from the cleanup route itself)
# Generate with: openssl rand -hex 32
INTERNAL_CLEANUP_SECRET=your-internal-cleanup-secret

# Secret used to authorize the Vercel cron job that triggers cleanup
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Optional: duration of each audio chunk in milliseconds (default: 2500)
# Must match the value used in the frontend recorder
NEXT_PUBLIC_CHUNK_DURATION_MS=2500

# Optional: public URL of the app (used for generating shareable links)
# In production this is your Vercel deployment URL, e.g., https://justadrop.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
